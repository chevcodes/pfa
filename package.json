{
  "name": "pfa",
  "version": "1.0.0",
  "description": "Private, on-device credit card statement analyser. One shared JavaScript core, Electron on the desktop, an installable PWA on iPhone and tablet. No backend, no account, no cloud.",
  "author": "chevcodes",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "desktop-app/electron-main.cjs",
  "scripts": {
    "postinstall": "node developer-tools/copy-vendor.js",
    "vendor": "node developer-tools/copy-vendor.js",
    "web": "node developer-tools/serve.js",
    "start": "electron .",
    "test": "node --test tests/*_proof.mjs",
    "build": "electron-builder",
    "lint": "eslint --config helpers/eslint.config.js",
    "mock:drift-check": "node developer-tools/merchant-drift-check.js"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-popover": "^1.1.23",
    "chokidar": "^3.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "pdfjs-dist": "^4.6.82",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0"
  },
  "allowScripts": {
    "electron": true
  },
  "build": {
    "appId": "com.ccanalyser.desktop",
    "productName": "Personal Finance Analyser",
    "files": [
      "index.html",
      "service-worker.js",
      "interface/**",
      "application/**",
      "settings/**",
      "desktop-app/**",
      "third-party/**"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "interface/icons/icon-512.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "interface/icons/icon-512.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "interface/icons/icon-512.png"
    }
  }
}
